---
import '@fontsource-variable/inter';
import '../styles/global.css';
import { profile } from '../data/profile';

type Props = { title?: string; description?: string };
const { title = `${profile.name} · ${profile.role}`, description = profile.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og.jpg', Astro.site).href;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  jobTitle: profile.role,
  url: Astro.site?.href,
  address: { '@type': 'PostalAddress', addressLocality: 'Toledo', addressCountry: 'ES' },
  sameAs: [profile.links.linkedin, profile.links.github, profile.links.instagram],
  knowsAbout: ['Flutter', 'React', 'Next.js', 'React Native', 'Node.js', 'Python', 'Claude Code', 'AI agents'],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <slot />
  </body>
</html>
