---
import { profile } from '../data/profile';
---

<section class="section contact" id="contacto" aria-labelledby="contacto-title">
  <div class="wrap">
    <h2 id="contacto-title">¿Hablamos?</h2>
    <p class="section-lead">
      Estoy abierto a nuevos proyectos y puestos, en remoto, híbrido o presencial. Escríbeme por LinkedIn y te respondo
      pronto.
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={profile.links.linkedin} target="_blank" rel="noopener">
        Escribirme por LinkedIn <span aria-hidden="true">↗</span>
      </a>
      <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>

<style>
  .contact {
    text-align: center;
  }

  .contact h2 {
    font-size: clamp(44px, 7vw, 88px);
  }

  .contact .section-lead {
    margin-inline: auto;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 32px;
  }
</style>
