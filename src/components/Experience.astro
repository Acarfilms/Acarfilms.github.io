---
import { experience } from '../data/profile';
---

<section class="section" id="experiencia" aria-labelledby="experiencia-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">Experiencia</p>
      <h2 id="experiencia-title">Del vídeo y el 3D al desarrollo de producto.</h2>
    </header>

    <ol class="timeline">
      {
        experience.map((item) => (
          <li class="reveal">
            <span class="period">{item.period}</span>
            <div class="what">
              <p class="role">{item.role}</p>
              <p class="place">{item.place}</p>
            </div>
            <div class="why">
              {item.note && <p class="note">{item.note}</p>}
              {item.href && (
                <a class="case" href={item.href}>
                  Ver el proyecto <span aria-hidden="true">→</span>
                </a>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: minmax(110px, 0.6fr) minmax(0, 1.4fr) minmax(0, 2fr);
    gap: 8px 32px;
    padding-block: 28px;
    border-top: 0.5px solid var(--line);
  }

  li:last-child {
    border-bottom: 0.5px solid var(--line);
  }

  .period {
    font-size: 15px;
    color: var(--text-2);
    font-variant-numeric: tabular-nums;
    padding-top: 3px;
  }

  .role {
    margin: 0;
    font-size: clamp(19px, 1.9vw, 22px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .place {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--text-2);
  }

  .note {
    margin: 0;
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-2);
  }

  .case {
    display: inline-block;
    margin-top: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--link);
  }

  .case:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 900px) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
