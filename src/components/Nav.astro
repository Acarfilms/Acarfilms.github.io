---
const items = [
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/como-trabajo/', label: 'Cómo trabajo' },
  { href: '/#experiencia', label: 'Experiencia' },
  { href: '/#stack', label: 'Stack' },
];
const path = Astro.url.pathname;
---

<header class="nav">
  <nav class="nav-bar" aria-label="Principal">
    <a class="nav-brand" href="/">Ángel Carrascosa</a>
    <ul class="nav-links">
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="nav-cta" href="/#contacto">Contacto</a>
  </nav>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding: calc(env(safe-area-inset-top, 0px) + 12px) var(--gutter) 0;
    pointer-events: none;
  }

  .nav-bar {
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 6px 6px 18px;
    border-radius: 999px;
    background: var(--glass);
    border: 0.5px solid var(--glass-line);
    box-shadow: 0 8px 32px rgb(0 0 0 / 0.08);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    backdrop-filter: blur(24px) saturate(180%);
  }

  .nav-brand {
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.01em;
    color: var(--text);
    white-space: nowrap;
    margin-right: 12px;
  }

  .nav-links {
    display: flex;
    gap: 2px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    display: block;
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 14px;
    color: var(--text-2);
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    color: var(--text);
    background: var(--hover);
  }

  .nav-cta {
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    background: var(--accent);
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: var(--accent-hover);
  }

  @media (max-width: 760px) {
    .nav-links {
      display: none;
    }
  }
</style>
