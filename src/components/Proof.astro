---
import Brands from './Brands.astro';
import { stats } from '../data/profile';
---

<section class="proof" aria-labelledby="proof-title">
  <div class="wrap">
    <p class="proof-title" id="proof-title">He desarrollado proyectos para marcas como</p>
    <Brands />

    <dl class="numbers">
      {
        stats.map((s) => (
          <div class="reveal">
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .proof {
    padding-block: clamp(24px, 4vw, 48px) clamp(80px, 10vw, 128px);
  }

  .proof-title {
    margin: 0 auto clamp(32px, 4vw, 48px);
    max-width: 30em;
    text-align: center;
    font-size: 17px;
    color: var(--text-2);
    text-wrap: balance;
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(64px, 8vw, 104px) 0 0;
    border-top: 0.5px solid var(--line);
  }

  .numbers div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding: 28px clamp(16px, 2vw, 28px) 0 0;
  }

  .numbers div + div {
    padding-left: clamp(16px, 2vw, 28px);
    border-left: 0.5px solid var(--line);
  }

  dd {
    margin: 0;
    font-size: clamp(32px, 3.6vw, 48px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  dt {
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-2);
    max-width: 18em;
  }

  @media (max-width: 900px) {
    .numbers {
      grid-template-columns: 1fr 1fr;
    }

    .numbers div:nth-child(3) {
      padding-left: 0;
      border-left: none;
    }

    .numbers div:nth-child(n + 3) {
      margin-top: 28px;
      border-top: 0.5px solid var(--line);
    }
  }

  @media (max-width: 520px) {
    .numbers {
      grid-template-columns: minmax(0, 1fr);
    }

    .numbers div,
    .numbers div + div {
      padding-left: 0;
      border-left: none;
    }

    .numbers div + div {
      margin-top: 24px;
      border-top: 0.5px solid var(--line);
    }
  }
</style>
