---
// A stylised Claude Code session: one prompt, an orchestrator and four subagents.
const agents = [
  ['explorer', 'mapea el módulo de citas'],
  ['builder', 'API y pantalla en Flutter'],
  ['reviewer', '2 sugerencias, aplicadas'],
  ['verifier', 'reserva probada en Playwright'],
];
---

<div class="term" role="img" aria-label="Sesión de Claude Code: pido una función, un orquestador la reparte entre cuatro subagentes que exploran, implementan, revisan y verifican, un hook bloquea la lectura de .env y termina con los tests en verde y una PR abierta para mi revisión.">
  <div class="term-bar" aria-hidden="true">
    <span class="lights"><i></i><i></i><i></i></span>
    <span class="term-title">claude · ~/app</span>
  </div>
  <div class="term-body" aria-hidden="true">
    <p class="ln" style="--i: 0"><span class="dim">~/app</span> <span class="acc">❯</span> claude</p>
    <p class="ln prompt" style="--i: 1">
      <span class="typed">&gt; Añade reservas online con pago por adelantado</span>
    </p>
    <p class="ln" style="--i: 3"><span class="dot">●</span> Reparto la tarea entre 4 subagentes</p>
    {
      agents.map(([name, task], i) => (
        <p class="ln agent" style={`--i: ${4 + i}`}>
          <span class="dim">⎿</span> <span class="name">{name}</span> <span class="task">{task}</span>
          <span class="ok">✓</span>
        </p>
      ))
    }
    <p class="ln guard" style="--i: 8"><span class="no">⊘</span> hook: lectura de .env bloqueada</p>
    <p class="ln done" style="--i: 9"><span class="ok">✓</span> Tests en verde · PR abierta para mi revisión<span class="caret"></span></p>
  </div>
</div>

<style>
  .term {
    width: 100%;
    border-radius: 16px;
    overflow: hidden;
    color: #f5f5f7;
    background: rgb(22 22 24 / 0.78);
    border: 0.5px solid rgb(255 255 255 / 0.18);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 30px 70px -20px rgb(0 0 0 / 0.55);
    -webkit-backdrop-filter: blur(30px) saturate(150%);
    backdrop-filter: blur(30px) saturate(150%);
  }

  .term-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    border-bottom: 0.5px solid rgb(255 255 255 / 0.1);
  }

  .lights {
    position: absolute;
    left: 14px;
    display: flex;
    gap: 7px;
  }

  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  .term-title {
    font-size: 12px;
    font-weight: 500;
    color: rgb(255 255 255 / 0.55);
  }

  .term-body {
    padding: clamp(14px, 2vw, 22px) clamp(16px, 2.2vw, 26px) clamp(18px, 2.4vw, 26px);
    font: clamp(11.5px, 1.05vw, 14px) / 1.75 var(--mono);
  }

  .ln {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .dim {
    color: rgb(255 255 255 / 0.45);
  }

  .acc {
    color: #64d2ff;
  }

  .dot {
    color: #bf5af2;
  }

  .prompt {
    color: #fff;
    margin-block: 6px;
  }

  .agent {
    padding-left: 1.2em;
  }

  .name {
    display: inline-block;
    min-width: 9ch;
    color: #64d2ff;
  }

  .task {
    color: rgb(255 255 255 / 0.78);
  }

  .ok {
    color: #30d158;
  }

  .guard {
    margin-top: 6px;
    color: rgb(255 255 255 / 0.6);
  }

  .no {
    color: #ff453a;
  }

  .agent .ok {
    margin-left: 0.5ch;
  }

  .done {
    margin-top: 6px;
  }

  .caret {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 0.4ch;
    vertical-align: -0.2em;
    background: rgb(255 255 255 / 0.7);
  }

  /* The session plays once; with reduced motion everything is simply there. */
  @media (prefers-reduced-motion: no-preference) {
    .ln {
      animation: ln-in 0.35s ease both;
      animation-delay: calc(0.5s + var(--i) * 0.5s);
    }

    .typed {
      display: inline-block;
      overflow: hidden;
      vertical-align: bottom;
      animation: type 1s steps(46, end) both;
      animation-delay: 1s;
    }

    .agent .ok {
      animation: ln-in 0.2s ease both;
      animation-delay: calc(0.85s + var(--i) * 0.5s);
    }

    .caret {
      animation: blink 1.1s steps(1) infinite;
    }

    @keyframes ln-in {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
    }

    @keyframes type {
      from {
        max-width: 0;
      }
      to {
        max-width: 100%;
      }
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }
  }
</style>
