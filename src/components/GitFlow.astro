---
// Trunk-based flow: short branches, a PR each, squash into main, release-please tags.
---

<svg class="flow" viewBox="0 0 600 190" role="img" aria-label="Flujo de git trunk-based: ramas cortas feat y fix que salen de main, vuelven por pull request con squash y terminan en una versión etiquetada por release-please.">
  <g class="branch">
    <path d="M60 64 C90 64 96 128 130 128 H250 C284 128 290 64 320 64" />
    <path d="M350 64 C380 64 386 150 420 150 H440 C474 150 480 64 510 64" />
  </g>
  <line class="trunk" x1="16" y1="64" x2="584" y2="64"></line>

  <g class="commit">
    <circle cx="60" cy="64" r="6"></circle>
    <circle cx="190" cy="64" r="6"></circle>
    <circle cx="320" cy="64" r="7" class="merge"></circle>
    <circle cx="350" cy="64" r="5"></circle>
    <circle cx="510" cy="64" r="7" class="merge"></circle>
  </g>
  <g class="commit side">
    <circle cx="160" cy="128" r="5"></circle>
    <circle cx="215" cy="128" r="5"></circle>
    <circle cx="430" cy="150" r="5"></circle>
  </g>

  <g class="tag">
    <rect x="532" y="20" width="56" height="24" rx="12"></rect>
    <text x="560" y="32">v1.4.0</text>
  </g>

  <g class="label">
    <text x="16" y="44" class="main">main</text>
    <text x="160" y="112">feat/agenda</text>
    <text x="430" y="174">fix/pagos</text>
    <text x="320" y="42" class="pr">PR · squash</text>
    <text x="470" y="42" class="pr">PR · squash</text>
  </g>
</svg>

<style>
  .flow {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .trunk {
    stroke: rgb(255 255 255 / 0.55);
    stroke-width: 2;
  }

  .branch path {
    fill: none;
    stroke: #64d2ff;
    stroke-width: 1.5;
  }

  .branch path:nth-child(2) {
    stroke: #ff9f0a;
  }

  .commit circle {
    fill: #161617;
    stroke: rgb(255 255 255 / 0.7);
    stroke-width: 2;
  }

  .commit .merge {
    fill: #0a84ff;
    stroke: none;
  }

  .side circle {
    fill: #161617;
    stroke: #64d2ff;
  }

  .side circle:nth-child(3) {
    stroke: #ff9f0a;
  }

  .tag rect {
    fill: color-mix(in srgb, #30d158 18%, #000);
    stroke: color-mix(in srgb, #30d158 60%, transparent);
  }

  .tag text {
    fill: #30d158;
    font: 600 11px var(--mono);
    text-anchor: middle;
    dominant-baseline: central;
  }

  .label text {
    fill: rgb(255 255 255 / 0.55);
    font: 12px var(--mono);
    text-anchor: middle;
  }

  .label .main {
    text-anchor: start;
    fill: rgb(255 255 255 / 0.85);
  }

  .label .pr {
    fill: #0a84ff;
    font-size: 11px;
  }
</style>
