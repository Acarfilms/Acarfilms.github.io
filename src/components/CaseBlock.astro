---
import Shot from './Shot.astro';
import Brands from './Brands.astro';
import CodeWindow from './CodeWindow.astro';
import type { Block } from '../data/projects';

type Props = { block: Block };
const { block } = Astro.props;

---

{
  block.kind === 'text' && (
    <section class="blk blk-text reveal">
      <h2>{block.title}</h2>
      <div class="prose">
        {block.body?.map((p) => <p>{p}</p>)}
        {block.points && (
          <ul class="points">
            {block.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        )}
      </div>
    </section>
  )
}

{
  block.kind === 'feature' && (
    <section id={block.id} class:list={['blk blk-feature reveal', { flip: block.flip }]}>
      <div class="feature-text">
        {block.eyebrow && <p class="eyebrow">{block.eyebrow}</p>}
        <h2>{block.title}</h2>
        {block.body.map((p) => (
          <p class="body">{p}</p>
        ))}
      </div>
      <div
        class:list={['feature-media', `n-${block.media.length}`, { tinted: block.tint }]}
        style={block.tint ? `--tint: ${block.tint}` : undefined}
      >
        {block.media.map((m) => (
          <Shot media={m} />
        ))}
      </div>
    </section>
  )
}

{
  block.kind === 'gallery' && (
    <section id={block.id} class="blk blk-gallery reveal">
      <div class="gallery-head">
        <h2>{block.title}</h2>
        {block.body?.map((p) => (
          <p class="body">{p}</p>
        ))}
      </div>
      <div class:list={['gallery', `n-${block.media.length}`]}>
        {block.media.map((m) => (
          <Shot media={m} />
        ))}
      </div>
    </section>
  )
}

{
  block.kind === 'index' && (
    <section class="blk blk-index reveal">
      <div class="gallery-head">
        <h2>{block.title}</h2>
        {block.body?.map((p) => (
          <p class="body">{p}</p>
        ))}
      </div>
      <ul class="index">
        {block.items.map((item) => (
          <li>
            <a class="card index-card" href={item.href}>
              <span class="index-media">
                <img
                  src={item.media.src}
                  alt=""
                  width={item.media.w}
                  height={item.media.h}
                  style={item.media.pos ? `object-position: ${item.media.pos}` : undefined}
                  loading="lazy"
                  decoding="async"
                />
              </span>
              <span class="index-text">
                <span class="index-title">{item.title}</span>
                <span class="index-desc">{item.text}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}

{
  block.kind === 'stats' && (
    <section class="blk blk-stats reveal">
      <dl>
        {block.items.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

{
  block.kind === 'brands' && (
    <section class="blk blk-brands reveal">
      <div class="gallery-head">
        <h2>{block.title}</h2>
        {block.body?.map((p) => (
          <p class="body">{p}</p>
        ))}
      </div>
      <div class="card brands-card">
        <Brands />
      </div>
    </section>
  )
}

{
  block.kind === 'code' && (
    <section class="blk blk-code reveal">
      <div class="feature-text">
        <h2>{block.title}</h2>
        {block.body.map((p) => (
          <p class="body">{p}</p>
        ))}
      </div>
      <div class="code-stack">
        {block.files.map((f) => (
          <CodeWindow name={f.name} code={f.code} />
        ))}
      </div>
    </section>
  )
}

<style>
  .blk {
    margin-top: clamp(72px, 9vw, 128px);
  }

  h2 {
    margin: 0;
    font-size: clamp(30px, 3.8vw, 48px);
    line-height: 1.06;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .eyebrow + h2 {
    margin-top: 10px;
  }

  .body,
  .prose p {
    margin: 18px 0 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }

  /* Text */
  .blk-text {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 16px clamp(32px, 5vw, 80px);
  }

  .blk-text h2 {
    font-size: clamp(26px, 3vw, 36px);
  }

  .prose p:first-child {
    margin-top: 0;
  }

  .points {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .prose p + .points {
    margin-top: 20px;
  }

  .points li {
    position: relative;
    padding-left: 22px;
    font-size: 17px;
    line-height: 1.55;
  }

  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.62em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Feature */
  .blk-feature,
  .blk-code {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: 32px clamp(32px, 5vw, 80px);
  }

  /* Media keeps the wider column on either side. */
  .blk-feature.flip {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }

  .flip .feature-text {
    order: 2;
  }

  .feature-media {
    display: grid;
    gap: 12px;
  }

  .feature-media.n-1:not(.tinted) :global(img),
  .feature-media.n-1:not(.tinted) :global(video) {
    max-height: 560px;
    object-fit: cover;
  }

  .feature-media.n-2 {
    grid-template-columns: 1fr 1fr;
    align-items: end;
  }

  .feature-media.n-3 {
    grid-template-columns: 1fr 1fr;
  }

  .feature-media.n-3 > :global(:first-child) {
    grid-column: 1 / -1;
  }

  .tinted {
    padding: clamp(24px, 4vw, 48px) clamp(24px, 4vw, 48px) 0;
    border-radius: var(--radius-l);
    background: var(--tint);
    overflow: hidden;
  }

  .tinted.n-1 :global(.shot) {
    width: 82%;
    margin-inline: auto;
    margin-bottom: -18%;
  }

  .tinted.n-2 :global(.shot) {
    margin-bottom: -10%;
  }

  /* Gallery */
  .gallery-head {
    max-width: 44em;
  }

  .gallery {
    display: grid;
    gap: var(--grid-gap);
    margin-top: clamp(32px, 4vw, 48px);
  }

  .gallery.n-2 {
    grid-template-columns: 1fr 1fr;
  }

  .gallery.n-3 {
    grid-template-columns: 1fr 1fr 1fr;
  }

  /* Index */
  .index {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: clamp(32px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
  }

  .index-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    color: inherit;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .index-card:hover {
    transform: translateY(-3px);
  }

  .index-media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--card-raised);
  }

  .index-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .index-card:hover .index-media img {
    transform: scale(1.03);
  }

  .index-text {
    display: grid;
    gap: 6px;
    padding: 20px 22px 24px;
  }

  .index-title {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .index-title::after {
    content: '\00a0→';
    color: var(--link);
  }

  .index-desc {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text-2);
  }

  /* Stats */
  .blk-stats dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--grid-gap);
    margin: 0;
  }

  .blk-stats dl div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 10px;
    padding: 26px 26px 28px;
    border-radius: var(--radius-l);
    background: var(--card);
  }

  .blk-stats dd {
    margin: 0;
    font-size: clamp(34px, 3.6vw, 48px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .blk-stats dt {
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-2);
  }

  /* Brands */
  .brands-card {
    margin-top: clamp(28px, 3.6vw, 40px);
    padding: clamp(32px, 5vw, 64px) clamp(20px, 4vw, 48px);
  }

  /* Code */
  .code-stack {
    display: grid;
    gap: 16px;
  }

  @media (max-width: 900px) {
    .blk-text,
    .blk-feature,
    .blk-feature.flip,
    .blk-code {
      grid-template-columns: minmax(0, 1fr);
    }

    .flip .feature-text {
      order: 0;
    }

    .gallery.n-3 {
      grid-template-columns: 1fr 1fr;
    }

    .gallery.n-3 > :global(:first-child) {
      grid-column: 1 / -1;
    }

    .index {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .gallery.n-2 {
      grid-template-columns: minmax(0, 1fr);
    }

    .index {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .index-card {
      flex-direction: row;
      align-items: center;
    }

    .index-media {
      flex: none;
      width: 112px;
      aspect-ratio: 1;
    }

    .index-text {
      padding: 14px 18px;
    }

    .index-title {
      font-size: 17px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .index-card,
    .index-media img {
      transition: none;
    }

    .index-card:hover {
      transform: none;
    }
  }

  @media (max-width: 600px) {

    .body,
    .prose p {
      font-size: 17px;
    }
  }
</style>
