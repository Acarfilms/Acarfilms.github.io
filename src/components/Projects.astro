---
import { getProject } from '../data/projects';

const mixreal = getProject('mixreal');
const iabeauty = getProject('iabeauty');
const vitrine = getProject('vitrine');
---

<section class="section section-alt" id="proyectos" aria-labelledby="proyectos-title">
  <div class="wrap">
    <header class="section-head">
      <p class="eyebrow">Proyectos</p>
      <h2 id="proyectos-title">Lo que he construido.</h2>
      <p class="section-lead">
        Las dos empresas en las que he llevado la tecnología y mi proyecto de código abierto, contados a fondo: qué hice,
        cómo lo hice y qué resultado tuvo.
      </p>
    </header>

    <a class="card pcard pcard-feature reveal" href={`/proyectos/${mixreal.slug}/`}>
      <div class="pcard-text">
        <p class="pcard-meta"><strong>{mixreal.name}</strong> · {mixreal.role} · {mixreal.period}</p>
        <h3>{mixreal.title}</h3>
        <p class="pcard-summary">{mixreal.summary}</p>
        <p class="pcard-chips-label" id="mixreal-proyectos">Proyectos en MixReal</p>
        <ul class="pcard-chips" aria-labelledby="mixreal-proyectos">
          {mixreal.highlights?.map((h) => <li>{h}</li>)}
        </ul>
        <span class="more">Ver los proyectos de MixReal <span aria-hidden="true">→</span></span>
      </div>
      <div class="collage" aria-hidden="true">
        <div class="c-main">
          <video
            src="/img/mixreal/totem-heineken.mp4"
            poster="/img/mixreal/totem-heineken.webp"
            width="540"
            height="960"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"></video>
          <img src="/img/mixreal/totem-heineken.webp" alt="" width="540" height="960" loading="lazy" />
        </div>
        <img src="/img/mixreal/mr-industria.webp" alt="" width="1280" height="720" loading="lazy" />
        <img src="/img/mixreal/vr-avatares-playa.webp" alt="" width="1280" height="720" loading="lazy" />
      </div>
    </a>

    <div class="pcard-row">
      <a class="card pcard reveal" href={`/proyectos/${iabeauty.slug}/`}>
        <div class="pcard-visual v-iabeauty" aria-hidden="true">
          <img class="v-photo" src="/img/iabeauty/salon-barberia.webp" alt="" width="1080" height="1349" loading="lazy" />
          <img class="v-device" src="/img/iabeauty/app-salon.webp" alt="" width="1400" height="1738" loading="lazy" />
        </div>
        <div class="pcard-text">
          <p class="pcard-meta"><strong>{iabeauty.name}</strong> · {iabeauty.role} · {iabeauty.period}</p>
          <h3>{iabeauty.title}</h3>
          <p class="pcard-summary">{iabeauty.summary}</p>
          <span class="more">Ver el proyecto <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <a class="card pcard reveal" href={`/proyectos/${vitrine.slug}/`}>
        <div class="pcard-visual v-vitrine" aria-hidden="true">
          <img src="/img/vitrine/hero.svg" alt="" width="840" height="390" loading="lazy" />
        </div>
        <div class="pcard-text">
          <p class="pcard-meta"><strong>{vitrine.name}</strong> · {vitrine.role} · {vitrine.period}</p>
          <h3>{vitrine.title}</h3>
          <p class="pcard-summary">{vitrine.summary}</p>
          <span class="more">Ver el proyecto <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>
  </div>
</section>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: inherit;
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 0.35s;
  }

  .pcard:hover {
    transform: translateY(-4px);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.25);
  }

  .pcard-text {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 3.4vw, 44px);
  }

  .pcard-meta {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
  }

  .pcard-meta strong {
    font-weight: 600;
    color: var(--text);
  }

  h3 {
    margin: 12px 0 0;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    font-weight: 700;
  }

  .pcard-summary {
    margin: 14px 0 0;
    font-size: 17px;
    line-height: 1.5;
    color: var(--text-2);
    max-width: 34em;
  }

  .pcard-chips-label {
    margin: 22px 0 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-3);
  }

  .pcard-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .pcard-chips li {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    color: var(--text-2);
    background: var(--chip);
  }

  .more {
    margin-top: 22px;
    font-size: 16px;
    font-weight: 500;
    color: var(--link);
  }

  .pcard:hover .more {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* MixReal */
  .pcard-feature {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
  }

  .pcard-feature h3 {
    font-size: clamp(30px, 3.8vw, 48px);
  }

  .collage {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 10px;
    padding: clamp(16px, 2.4vw, 28px) clamp(16px, 2.4vw, 28px) clamp(16px, 2.4vw, 28px) 0;
    height: 100%;
    min-height: 360px;
  }

  .collage img,
  .collage video {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    border-radius: 18px;
    background: var(--card-raised);
  }

  .c-main {
    grid-row: span 2;
    min-height: 0;
  }

  .c-main img,
  .c-main video {
    object-position: center 32%;
  }

  .c-main img {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .c-main video {
      display: none;
    }

    .c-main img {
      display: block;
    }
  }

  /* Row */
  .pcard-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-top: var(--grid-gap);
  }

  .pcard-visual {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    height: clamp(260px, 30vw, 380px);
    overflow: hidden;
  }

  .v-iabeauty {
    position: relative;
    isolation: isolate;
    background: #01241b;
  }

  .v-iabeauty::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 18%, #01241b 62%),
      radial-gradient(60% 70% at 78% 100%, rgb(231 255 169 / 0.18), transparent 70%);
  }

  .v-photo {
    position: absolute;
    inset: 0 auto 0 0;
    width: 62%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  .v-device {
    position: absolute;
    z-index: 2;
    right: 5%;
    top: 12%;
    width: 52%;
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.45));
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pcard:hover .v-device {
    transform: translateY(-10px);
  }

  .v-vitrine {
    align-items: center;
    padding: 28px;
    background: radial-gradient(120% 120% at 70% 0%, #1e3a8a 0%, #0b1026 70%);
  }

  .v-vitrine img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    box-shadow: 0 24px 50px -20px rgb(0 0 0 / 0.6);
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .pcard:hover .v-vitrine img {
    transform: scale(1.02);
  }

  @media (max-width: 900px) {
    .pcard-feature,
    .pcard-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .collage {
      order: -1;
      min-height: 0;
      height: auto;
      aspect-ratio: 16 / 10;
      padding: 16px 16px 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard,
    .pcard img {
      transition: none;
    }

    .pcard:hover {
      transform: none;
    }
  }
</style>
